<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for F1 Live Assistant -->
    <style name="Theme.F1Live" parent="android:Theme.DeviceDefault.NoActionBar">
        <!-- Fullscreen -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">#0d1117</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">#0d1117</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Background -->
        <item name="android:windowBackground">#0d1117</item>
    </style>
</resources>
